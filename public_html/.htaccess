# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# ==============================================================================
# Avix Treims - Production Apache / LiteSpeed Routing Configuration
# High-Performance, PHP 8.2 Compatible, Clean URLs & Direct Root Loading
# ==============================================================================

# ----------------------------------------------------------------------
# 1. Directory Index Priority: Always load index.php first
# ----------------------------------------------------------------------
# Guarantees that visiting https://avxtsinc.com/ immediately loads index.php
# without requiring "/index.php" in the URL or showing a directory index.
DirectoryIndex index.php index.phtml index.html index.htm home.php

# ----------------------------------------------------------------------
# 2. Server Security & Execution Options
# ----------------------------------------------------------------------
# Prevent directory listing (browsing folder files)
Options -Indexes

# Disable content negotiation (MultiViews) so clean URLs resolve strictly
<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

# Safely enable SymLinks without triggering 500 errors on shared hosts
<IfModule mod_rewrite.c>
    Options +SymLinksIfOwnerMatch
</IfModule>

# ----------------------------------------------------------------------
# 3. Complete URL Routing & Redirection Engine
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Pass Authorization Header to PHP for APIs & Basic Auth
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # A. 301 Permanent Redirect: Legacy /uadmin to new /controller
    RewriteRule ^uadmin/?(.*)$ controller/$1 [R=301,L]

    # B. Prevent cPanel default holding pages (default.html / index.html) from overriding index.php
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(default|index)\.html?\ HTTP/ [NC]
    RewriteRule ^(default|index)\.html?$ / [R=301,L]

    # C. Canonical URL: If someone types "/index.php" in browser, redirect cleanly to "/"
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.php\ HTTP/ [NC]
    RewriteRule ^index\.php$ / [R=301,L]

    # D. Direct Root Loading: When domain root is accessed, serve index.php instantly
    RewriteRule ^$ index.php [L]
    RewriteRule ^/$ index.php [L]

    # E. Support Clean URLs without .php extension (e.g. /signin -> signin.php, /about -> about.php)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/$1.php -f [OR]
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.php [NC,L]

    # F. If physical file or folder exists, serve directly (CSS, JS, images, downloads)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # G. Global Front-Controller Fallback: route any other unmatched non-file requests to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [L]
</IfModule>

# ----------------------------------------------------------------------
# 4. Security Lockdown: Block Direct Access to Database Dumps & Configs
# ----------------------------------------------------------------------
<FilesMatch "\.(sql|env|log|sh|bak|git|sqlite)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Protect hidden dotfiles while allowing SSL validation (.well-known)
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} !/\.well-known/ [NC]
    RewriteRule (^|/)\. - [F]
</IfModule>

# ----------------------------------------------------------------------
# 5. PHP 8.2 Execution Directives (Safe for mod_php environments)
# ----------------------------------------------------------------------
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
    php_value memory_limit 256M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>

# ----------------------------------------------------------------------
# 6. Security & Performance Headers
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>

# ----------------------------------------------------------------------
# 7. Gzip Compression for Fast Page Delivery
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>
